# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Source code files
*.kt text eol=lf
*.go text eol=lf
*.rs text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.properties text eol=lf
*.txt text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.aar binary
*.jar binary
*.so binary
*.apk binary
*.bin binary
